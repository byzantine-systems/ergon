{application, ergon, [
    {description,
        "PostgreSQL-native background job and workflow processing, built on "
        "PostgreSQL 19 temporal tables, SQL/PGQ property graphs, pgmq durable "
        "queues, and pg_cron scheduling."},
    {vsn, "0.5.0"},
    {registered, [ergon_sup, ergon_sql]},
    {mod, {ergon_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        pgo,
        migraterl,
        worker_pool,
        backoff
    ]},
    {env, []},
    {modules, []},

    %% == Hex package metadata ==
    {licenses, ["LGPL-3.0-only"]},
    {links, [
        {"GitHub", "https://github.com/byzantine-systems/ergon"},
        {"Changelog", "https://github.com/byzantine-systems/ergon/releases"}
    ]},
    {build_tools, ["rebar3"]},
    %% Spelling this out replaces rebar3_hex's default file set, which we need
    %% for two reasons. COPYING.LESSER: LGPL-3.0 is the GPL-3.0 text plus the
    %% Lesser grant, and the default only globs LICENSE*, so the tarball would
    %% ship the GPL half of a two-file licence on its own. examples/: every
    %% entry in the ex_doc `extras` list lives there, so leaving it out makes
    %% the published sources unable to rebuild their own documentation.
    {files, [
        "src",
        "include",
        "priv",
        "examples",
        "rebar.config",
        "rebar.lock",
        "README.md",
        "LICENSE",
        "COPYING.LESSER"
    ]}
]}.
