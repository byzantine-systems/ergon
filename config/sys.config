%% Ergon's runtime configuration.
%%
%% Connection credentials are deliberately absent: ergon_repo reads PGHOST,
%% PGPORT, PGUSER, PGPASSWORD, and PGDATABASE from the environment at boot, so
%% they stay out of the repository and a release picks them up without a rebuild.
%% ergon_migrate reads the same variables with the same defaults.
[
    {ergon, [
        %% pool     the pgo pool name. Not `default`, so running inside a host
        %%          application never clobbers that host's own default pool.
        %% pool_size number of connections.
        {ergon_repo, [
            {pool, ergon},
            {pool_size, 10}
        ]},

        %% retry_backoff how long an errored job waits before it is runnable
        %%               again. The delay is computed by ergon.retry_backoff in
        %%               the database; these are its arguments.
        %%
        %%   strategy  full_jitter  random(0, ceiling), the recommended one
        %%             equal_jitter ceiling/2 + random(0, ceiling/2)
        %%             none         the ceiling itself, unjittered
        %%   base_ms   the first retry's ceiling. Doubles with each attempt.
        %%   cap_ms    the ceiling stops growing here.
        %%
        %% Jitter is what stops a batch of jobs that failed together from
        %% retrying together. See ergon.retry_backoff for the formulas and their
        %% source.
        {ergon_db, [
            {retry_backoff, [
                {strategy, full_jitter},
                {base_ms, 1000},
                {cap_ms, 100000}
            ]}
        ]},

        %% extra_roots additional priv/queries-style directories to load, for
        %%             host-owned domains. See the ergon_sql module docs for the
        %%             accepted forms.
        {ergon_sql, [
            {extra_roots, []}
        ]},

        %% enabled  the reactive LISTEN/NOTIFY wake path. Turning it off is
        %%          supported and safe: workers fall back to their periodic poll,
        %%          which drains everything correctly, just with more latency. It
        %%          is also useless without pg_cron, since the tick that emits
        %%          the notifications is a cron job.
        {ergon_job_notifier, [
            {enabled, true}
        ]}
    ]},

    {kernel, [
        {logger_level, notice}
    ]}
].
